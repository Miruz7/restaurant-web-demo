# Identidad básica
VITE_APP_NAME="Papelería Nova"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# API Backend (por definir)
VITE_API_BASE_URL="https://api.papelerianova.example"
VITE_API_TIMEOUT_MS="10000"

# Integración futuro e-commerce / CMS (valores dummy por ahora)
VITE_PUBLIC_SUPABASE_URL=""
VITE_PUBLIC_SUPABASE_ANON_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Otros
VITE_CONTACT_EMAIL="hola@papelerianova.example"
VITE_CONTACT_PHONE=""
